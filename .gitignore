# --- Never commit: forum data ------------------------------------------
# Saved topic pages and everything derived from them contain live download
# links to scanned comics. Nothing under these paths belongs in git.
spike/pages/
spike/fixtures/
spike/*.json
spike/*.csv

# Pages and archive headers `retrospec-build` has already fetched, so a
# rebuild asks the site for each one once. Everything here is a copy of a
# public static page — it is ignored because it is derived and bulky, not
# because it is sensitive. The catalogue built *from* it is committed.
.retrospec-cache/

# --- Build artefacts ---------------------------------------------------
.build/
.swiftpm/
DerivedData/
# NB: git has no inline comments — a '#' only starts a comment at the start of
# a line, so a trailing comment becomes part of the pattern and matches nothing.
# xcodebuild archive/export output: the .xcarchive and the signed .ipa
build/

# xcodebuild -derivedDataPath
.xcbuild/
.xcbuild-device/
.xcbuild-release/
.simbuild/
# Snapshot of the simulator's logged-in forum session (cookies). Local only.
.simsession/

# The paired device's identifier. Names a specific piece of hardware, so it
# belongs to this machine rather than the repository. Written by
# `./scripts/device.sh setup`.
.device
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
*.xcuserstate
*.xcodeproj/project.xcworkspace/xcuserdata/

# --- Python ------------------------------------------------------------
__pycache__/
*.pyc

# --- macOS -------------------------------------------------------------
.DS_Store
