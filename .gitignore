# --- Never commit: forum data ------------------------------------------
# Saved topic pages and everything derived from them contain live download
# links to scanned comics. Nothing under these paths belongs in git.
spike/pages/
spike/fixtures/
spike/*.json
spike/*.csv
# Local-only dev seed: a real saved topic page with live download links in it.
# Same rule as spike/pages — forum data, not a build artefact. Named DevSeed
# rather than Resources so that App/Resources stays free for real, committable
# app resources instead of being silently swallowed by this rule.
App/DevSeed/

# --- Build artefacts ---------------------------------------------------
.build/
.swiftpm/
DerivedData/
# NB: git has no inline comments — a '#' only starts a comment at the start of
# a line, so a trailing comment becomes part of the pattern and matches nothing.
# xcodebuild -derivedDataPath
.xcbuild/
.simbuild/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
*.xcuserstate
*.xcodeproj/project.xcworkspace/xcuserdata/

# --- Python ------------------------------------------------------------
__pycache__/
*.pyc

# --- macOS -------------------------------------------------------------
.DS_Store
